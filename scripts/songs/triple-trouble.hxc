        imageRow1.addComponent(ringContainer);

        page1.addComponent(imageRow1);

        page1.addComponent(createTerm("Ring Notes", "Ring Notes are special notes that do not penalize the player when missed. \nBut they also do not add to your score or combo."));
        page1.addComponent(createTerm("\nMechanics", "Though Ring Notes do not contribute to your score, they can be used to protect it. \nWhen a ring is in hand, your next miss or bad combo rating will not count. \nThis also protects the player against custom notetypes, like Phantom Notes."));
        
        pages.push(page1);
