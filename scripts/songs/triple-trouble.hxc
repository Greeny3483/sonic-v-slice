    public function new() {
        super("triple-trouble");

        hasPlayedCutscene = false;
        hasShownGuide = false;
    }

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);

        doRingMechanic = Save.instance.modOptions["doRingMechanic"];
        doFreeplayCuts = Save.instance.modOptions["doFreeplayCuts"];

        if (doRingMechanic) {
            EXERingMechanic.useRingMechanic();
        }

        hasPlayedCutscene = false;
        //hasShownGuide = false;

        if ((PlayStatePlaylist.isStoryMode || doFreeplayCuts) && !hasPlayedCutscene) {
            var intro = ModuleHandler.getModule('EXEIntros');
            if (intro != null) intro.scriptSet('skipNextIntro', true);
        }
    }

    function onGameOver():Void {
        super.onGameOver();
    }
    
    function onSongRetry():Void {
        super.onSongRetry();

        hasPlayedCutscene = true;
        //hasShownGuide = false; 
    }

    public override function onCountdownStart(event:CountdownScriptEvent):Void {
        super.onCountdownStart(event);

        if (!PlayStatePlaylist.isStoryMode && !doFreeplayCuts) hasPlayedCutscene = true;

        if (!hasPlayedCutscene) {
            trace('Pausing countdown to play a video cutscene (`triple trouble`)');
            hasPlayedCutscene = true;
            event.cancel();
            startVideo();
            return;
        }

        /*if (doRingMechanic && !hasShownGuide) {
            hasShownGuide = true;
            event.cancel(); 
            showRingGuide();
            return;
        }*/
    }

    /*override function onUpdate(event:UpdateScriptEvent):Void {
