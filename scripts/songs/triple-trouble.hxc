        page2.addComponent(imageRow2);
        page2.addComponent(createTerm("5th Strumline Member", "When the ring mechanic is active, a 5th strumline member will be added in a lane located in-between the UP and DOWN arrows. This lane is reserved for Ring Notes. \n\nIf the 'Ring Mechanic' option is disabled, Ring Notes will still spawn on the strumline, but there will be no extra strumline member. They will appear on any of the 4 lanes. \n\nHitting a Ring Note will the option turned off will not benefit the player in any way."));

        pages.push(page2);
