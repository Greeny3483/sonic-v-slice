    function createTerm(titleText:String, descText:String):VBox {
        var box = new VBox();
        box.percentWidth = 100;
        box.marginBottom = 15;

        box.addComponent(createSectionHeader(titleText));

        var desc = new Label();
        desc.text = descText;
        desc.percentWidth = 100;
        desc.fontSize = 15;
        desc.color = 0xCCCCCC; 
        box.addComponent(desc);

        return box;
    }

    function showRingGuide() {
        isShowingGuide = true;
        currentPageIndex = 0;
        pages = []; 

        var helpWindow = new Window();
        helpWindow.title = "Help Guide";
        helpWindow.width = 1000;
        helpWindow.height = 600;
        helpWindow.x = (FlxG.width - 1000) / 2;
        helpWindow.y = (FlxG.height - 600) / 2;
        helpWindow.closable = false; 

        var mainLayout = new VBox();
        mainLayout.percentWidth = 100;
        mainLayout.percentHeight = 100;
        mainLayout.padding = 20;

