        if (isShowingGuide) {
            if (FlxG.keys.justPressed.SPACE || FlxG.keys.justPressed.ENTER || FlxG.keys.justPressed.ESCAPE) {
                closeRingGuide();
            }
        }
    }*/

    function startVideo() {
        VideoCutscene.play(Paths.videos('youcantruncutscene2'));
    }

