import flixel.FlxG;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.util.ReflectUtil;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.FunkinSprite;
import flixel.addons.display.FlxBackdrop;
import flixel.util.FlxColor;
import funkin.save.Save;

import EXEShaders;
import EXEScripts;
import EXEOverlays;

class StardustSpeedway extends Stage {

    public function new() {
        super('stardustSpeedway');
    }

	var sonicrunning:FunkinSprite;
	var furnaceflying:FunkinSprite;
	var furnaceGotcha:FunkinSprite;
	
	var stardustBg:FlxBackdrop;
	var stardustFloor:FlxBackdrop;
	
	var bgSpeed:Float = 2500;

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);

		doGenesisMode = Save.instance.modOptions["doGenesisMode"];
		if (doGenesisMode) {
            EXEShaders.initShader("vcr");
			EXEWindow.resizeWindow(960, 720);
		}

        getNamedProp('Background').visible = false;
        getNamedProp('Floor').visible = false; // we're going to disable these in favor of FlxBackdrop

		// Stage Props

        stardustBg = new FlxBackdrop(Paths.image("stages/stardustSpeedway/stardustBg"), FlxBackdrop.X);
        stardustBg.y = -1820;
        stardustBg.velocity.x = -(bgSpeed / 2);
        stardustBg.zIndex = -2;
        add(stardustBg);

        stardustFloor = new FlxBackdrop(Paths.image("stages/stardustSpeedway/stardustFloor"), FlxBackdrop.X);
        stardustFloor.y = -2185;
        stardustFloor.velocity.x = -bgSpeed;
        stardustFloor.zIndex = 301;
        add(stardustFloor);

		// layered perfectly on top of the actual sonic character, used for the intro sequence
		sonicrunning = FunkinSprite.create(540, -170);
		sonicrunning.frames = Paths.getSparrowAtlas('characters/running_sonic_sheet');
		sonicrunning.animation.addByPrefix('idle', 'sonic idle', 24, true);
		sonicrunning.animation.play('idle');
		sonicrunning.antialiasing = false; //pickzel
		sonicrunning.scale.set(6, 6);
		sonicrunning.zIndex = 200;
		sonicrunning.alpha = 0;

		// when he flys below the track later in the song
		furnaceflying = FunkinSprite.create(-1000, 300);
		furnaceflying.frames = Paths.getSparrowAtlas('characters/Furnace_sheet');
		furnaceflying.animation.addByPrefix('idle', 'Furnace idle', 24, true);
		furnaceflying.animation.play('idle');
		furnaceflying.antialiasing = false;
		furnaceflying.scale.set(6, 6);
		furnaceflying.zIndex = 20;
		PlayState.instance.add(furnaceflying);

		// at the end of the song, when he grabs you
		furnaceGotcha = FunkinSprite.create(4000, -140, 'stages/stardustSpeedway/extra/furnace_gotcha');
		furnaceGotcha.scale.set(6, 6);
		furnaceGotcha.antialiasing = false;
		furnaceGotcha.flipX = true;
		furnaceGotcha.zIndex = 20;
		PlayState.instance.add(furnaceGotcha);
	}

	override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

        if (PlayState.instance.currentSong.id.toLowerCase() != "prey") return;

		PlayState.instance.camHUD.alpha = 0;

		getDad().x = -1200; // Starting position
		EXEOverlays.createOverlay(0, "", 100, 1, 10, 000000, 0.01);
		PlayState.instance.add(sonicrunning);
		FlxTween.tween(sonicrunning, {alpha: 1}, 16);
	}

	function onStepHit(event:SongTimeScriptEvent):Void {
		super.onStepHit(event);

		if (PlayState.instance.currentSong.id.toLowerCase() != "prey") return;

		switch (event.step) {
			case 127:
				FlxG.camera.flash(0xFFFFFFFF, 1);
				PlayState.instance.remove(sonicrunning);
				EXEOverlays.removeOverlay(0, 0.000001); // fade out black overlay quickly
				EXEScripts.triggerCinematics(100, 1, "instant", true, false);
			case 256:
				EXEScripts.disableCinematics(1, "slide");
				FlxTween.tween(getDad(), {x: -100}, 0.2);
				FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 1);
			case 1539:
				EXEScripts.triggerCinematics(100, 1, "slide", true, false);
				FlxTween.tween(getDad(), {x: -4000}, 8);
				FlxTween.tween(getDad(), {angle: -45}, 3, {ease: FlxEase.quadInOut});
			case 1584:
				getDad().angle = 0;
				FlxTween.tween(getDad(), {x: 680}, 2.5);
			case 1789:
				EXEScripts.disableCinematics(1, "slide");
				bgSpeed = 5000;
				updateBackgroundVelocity();
			case 2432:
				FlxTween.tween(furnaceflying, {x: 2400}, 12);
			case 3333:
				EXEScripts.triggerCinematics(100, 1, "slide", true, false);
			case 3335:
				FlxTween.tween(getDad(), {x: -2000}, 7);
			case 3365:
				FlxTween.tween(furnaceGotcha, {x: -500}, 0.2);
			case 3367:
				PlayState.instance.camCutscene.flash(FlxColor.RED, 2);
                EXEOverlays.createOverlay(2, "camCutscene", 500, 1, 10, 000000, 0.0001); // ID, camera, zIndex, alpha, size, color, fade
		}
	}

	override function onUpdate(event:ScriptEvent):Void {
		super.onUpdate(event);
		
		if (doGenesisMode) EXEShaders.updateShader("vcr");
	}

	function updateBackgroundVelocity():Void {
		if (stardustBg != null) stardustBg.velocity.x = -(bgSpeed / 2);
		if (stardustFloor != null) stardustFloor.velocity.x = -bgSpeed;
	}

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);

		if (PlayState.instance.currentSong.id.toLowerCase() != "prey") return;

		EXEOverlays.clearOverlays(); // Prevent EXEOverlays from stacking

		if (furnaceflying != null) {
			furnaceflying.x = -1000;
			furnaceflying.y = 300;
		}

		if (furnaceGotcha != null) {
			furnaceGotcha.x = 4000;
			furnaceGotcha.y = -140;
		}

		if (getDad() != null) {
			getDad().x = -1000;
			getDad().angle = 0;
		}

	    if (sonicrunning != null) {
			sonicrunning.alpha = 0;
		}

		bgSpeed = 2500;
		if (stardustBg != null) stardustBg.x = 0;
		if (stardustFloor != null) stardustFloor.x = 0;
		updateBackgroundVelocity();

		var starvedBG = getNamedProp('Background');
		var starvedGround = getNamedProp('Floor');
		
		if (starvedBG != null) {
			starvedBG.offset.x = 0;
		}
		
		if (starvedGround != null) {
			starvedGround.offset.x = 0;
		}

		PlayState.instance.camHUD.alpha = 0;
		FlxTween.cancelTweensOf(sonicrunning);
		FlxTween.cancelTweensOf(furnaceflying);
		FlxTween.cancelTweensOf(furnaceGotcha);
		FlxTween.cancelTweensOf(getDad());
		FlxTween.cancelTweensOf(PlayState.instance.camHUD);
	}
}