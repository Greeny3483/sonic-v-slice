import flixel.util.FlxTimer;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.play.PlayState;
import funkin.play.stage.Stage;

import EXEOverlays;

class SeriousTable extends Stage
{
	public function new()
	{
		super('seriousTable');
	}

	override function onCreate(event:ScriptEvent):Void
	{
		super.onCreate(event);

		EXEOverlays.createOverlay(0, "", 400, 1, 5, 000000, 0.0001); // ID, camera, zIndex, alpha, size, color, fade
	}

	override function onCountdownStart(event:CountdownScriptEvent):Void
	{
		super.onCountdownStart(event);

        new FlxTimer().start(0.000001, function(tmr)
        {
			PlayState.instance.camHUD.alpha = 0;
        });
	}

	function onStepHit(event:SongTimeScriptEvent):Void
	{

		if (event.beat % 4 == 0) // 
		{
			FlxTween.tween(getNamedProp('light'), { alpha: 0.7 }, 0.02, { ease: FlxEase.quadInOut, onComplete: function(_) {
				FlxTween.tween(getNamedProp('light'), { alpha: 1 }, 0.02, { ease: FlxEase.quadInOut });
			}});
		}

		switch(event.step) {
			case 31:
				PlayState.instance.camHUD.alpha = 1;
			    EXEOverlays.setAlpha(0, 0.4); // ID, alpha, optional fade
			case 813:
				EXEScripts.triggerJumpscare("shadow");
		}
	}
}
