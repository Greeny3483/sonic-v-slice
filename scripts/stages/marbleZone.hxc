import flixel.tweens.FlxTween;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.SongTimeScriptEvent;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.character.CharacterType;
import funkin.play.character.BaseCharacter;
import funkin.play.character.CharacterDataParser;
import flixel.addons.display.FlxRuntimeShader;
import openfl.Assets;
import openfl.filters.ShaderFilter;
import funkin.modding.module.ModuleHandler;
import flixel.FlxG;

class MarbleZone extends Stage 
{
	var sarah:BaseCharacter;
	var lastDadAnim:String = "";

    var doVCRShaders:Bool = true;

	var vcrShader:FlxRuntimeShader;
	var shaderTime:Float = 0;

	public function new()
	{
		super('marbleZone');
	}

    override function onCreate(event:ScriptEvent):Void {
		super.onCreate(event);

        EXEShaders.initShader("vcr");

        if (PlayState.instance.currentSong.id.toLowerCase() == "round-a-bout") {
            sarah = CharacterDataParser.fetchCharacter('Sarah');
            sarah.characterType = CharacterType.DAD;

            sarah.x = -1010;
            sarah.y = -980;
            sarah.alpha = 0;
            
            sarah.playAnimation('idle');
        }
    }

    override function onUpdate(event:UpdateScriptEvent):Void {
        super.onUpdate(event);

        EXEShaders.updateShader("vcr");

        if (PlayState.instance.currentSong.id.toLowerCase() == "round-a-bout") {
            if (sarah != null) {
                var dadAnimName = PlayState.instance.currentStage.getDad().animation.curAnim.name;

                if (dadAnimName == 'singLEFT') {
                    if (lastDadAnim != dadAnimName) {
                        sarah.playAnimation('singLEFT', true);
                    }
                    else if (sarah.animation.curAnim != null && sarah.animation.finished) {
                        sarah.playAnimation('singLEFT', true);
                    }
                    lastDadAnim = dadAnimName;
                }
                else if (dadAnimName == 'singDOWN') {
                    if (lastDadAnim != dadAnimName) {
                        sarah.playAnimation('singDOWN', true);
                    }
                    else if (sarah.animation.curAnim != null && sarah.animation.finished) {
                        sarah.playAnimation('singDOWN', true);
                    }
                    lastDadAnim = dadAnimName;
                }
                else if (dadAnimName == 'singUP') {
                    if (lastDadAnim != dadAnimName) {
                        sarah.playAnimation('singUP', true);
                    }
                    else if (sarah.animation.curAnim != null && sarah.animation.finished) {
                        sarah.playAnimation('singUP', true);
                    }
                    lastDadAnim = dadAnimName;
                }
                else if (dadAnimName == 'singRIGHT') {
                    if (lastDadAnim != dadAnimName) {
                        sarah.playAnimation('singRIGHT', true);
                    }
                    else if (sarah.animation.curAnim != null && sarah.animation.finished) {
                        sarah.playAnimation('singRIGHT', true);
                    }
                    lastDadAnim = dadAnimName;
                }
                else if (dadAnimName == 'idle') {
                    lastDadAnim = dadAnimName;
                }
            }
        }
    }
    
    function onBeatHit(event:SongTimeScriptEvent):Void {
        super.onBeatHit(event);

        if (PlayState.instance.currentSong.id.toLowerCase() == "round-a-bout" && sarah != null && lastDadAnim == 'idle') {
            var currentSarahAnim = sarah.animation.curAnim;
            if (currentSarahAnim == null || currentSarahAnim.name == 'idle' || currentSarahAnim.finished) {
                sarah.playAnimation('idle');
            }
        }
    }

    function onStepHit(event:SongTimeScriptEvent):Void {
        super.onStepHit(event);

        if (event.step == 761 && PlayState.instance.currentSong.id.toLowerCase() == "round-a-bout") {
            sarah.zIndex = 100;
            PlayState.instance.add(sarah);
            FlxTween.tween(sarah, { alpha: 0.7 }, 1);

            PlayState.instance.currentStage.getDad().zIndex = 201;
            PlayState.instance.currentStage.refresh();
        }
    }

    override function onSongRetry(event:ScriptEvent):Void {
        super.onSongRetry(event);

        if (sarah != null && PlayState.instance.currentSong.id.toLowerCase() == "round-a-bout") {
            sarah.alpha = 0;
            if (PlayState.instance != null && PlayState.instance.members.contains(sarah)) {
                PlayState.instance.remove(sarah);
            }
        }
    }
}