import flixel.FlxG;
import flixel.FlxSprite;
import flixel.util.FlxTimer;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.Paths;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.FunkinMemory;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.graphics.video.FunkinVideoSprite;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;

class EXEScripts extends Module {
    // This module handles scripted events for various songs (ex, jumpscares)

    public function new() {
        super("EXEScripts");
    }

    public static var daSTAT:FlxSprite = null;
    public static var isDaSTATCreated:Bool = false;
    public static var topBorder:FlxSprite = null;
	public static var bottomBorder:FlxSprite = null;
    public static var isBordersCreated:Bool = false;
    public static var blackBG:FlxSprite = null;
    public static var isBlackBGCreated:Bool = false;
    public static var doCinematics:Bool = false;
    public static var doJumpscares:Bool = false;

    public static function resetVariables():Void {
        daSTAT = null;
        isDaSTATCreated = false;
        topBorder = null;
        bottomBorder = null;
        isBordersCreated = false;
        blackBG = null;
        isBlackBGCreated = false;
        screenGlitch = null;
        isScreenGlitchCreated = false;
        sonicJump = null;
        tailsJump = null;
        knucklesJump = null;
        eggmanJump = null;
        redVignette = null;
        isRedVignetteCreated = false;
        sonicJumpAnim = null;
    }

    override function onSongLoaded(event):Void {
        super.onSongLoaded(event);
        resetVariables();

        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/sonicJUMPSCARE")); // sonicJumpAnim
        Paths.getSparrowAtlas("events/jumpscares/sonicJUMPSCARE");

        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/Sonic")); // sonicJump
        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/Tails")); // tailsJump
        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/Knuckles")); // knucklesJump
        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/Eggman")); // eggmanJump
        FunkinMemory.cacheTexture(Paths.image("events/jumpscares/SHADOWTHEFUCKINGHEDGEHOG"));
        FunkinMemory.cacheTexture(Paths.image("events/daSTAT")); // daSTAT
        FunkinMemory.cacheTexture(Paths.image("events/RedVG")); // redVignette
        FunkinMemory.cacheTexture(Paths.image("events/P3_Stat")); // screenGlitch

        FunkinMemory.cacheSound(Paths.sound("TailsScreamLOL", "shared"));
		FunkinMemory.cacheSound(Paths.sound("KnucklesScreamLOL", "shared"));
		FunkinMemory.cacheSound(Paths.sound("EggmanScreamLOL", "shared"));
        FunkinMemory.cacheSound(Paths.sound("datOneSound", "shared"));
        FunkinMemory.cacheSound(Paths.sound("jumpscare", "shared"));
        FunkinMemory.cacheSound(Paths.sound("sppok", "shared"));
        FunkinMemory.cacheSound(Paths.sound("vboom", "shared"));
    }

    public static function triggerStatic(?camera:String = "camHUD", ?alpha:Float = 0.3, ?useRandomAlpha:Bool = true):Void {
        var doScreenStatic = Save.instance.modOptions["doScreenStatic"];
        if (!doScreenStatic) return;

        if (!isDaSTATCreated) {
            daSTAT = new FlxSprite(100, 0);
            daSTAT.frames = Paths.getSparrowAtlas("events/daSTAT");
            daSTAT.animation.addByPrefix('static', 'staticFLASH', 30, false);
            daSTAT.scale.set(FlxG.onMobile ? 6.15 : 5, FlxG.onMobile ? 5.1 : 5);
            switch (camera) {
                case "camGame":
                    daSTAT.cameras = [PlayState.instance.camGame];
                case "camHUD":
                    daSTAT.cameras = [PlayState.instance.camHUD];
                case "camCutscene":
                    daSTAT.cameras = [PlayState.instance.camCutscene];
                default:
                    daSTAT.cameras = [PlayState.instance.camHUD];
            }
            daSTAT.zIndex = 5000;
            daSTAT.alpha = useRandomAlpha ? FlxG.random.float(0.1, 0.5) : alpha;
            daSTAT.visible = false;
            PlayState.instance.add(daSTAT);
            isDaSTATCreated = true;
        }

        if (daSTAT != null) {
            daSTAT.visible = true;
            daSTAT.animation.play('static');
            daSTAT.animation.finishCallback = function(name:String) {
                if (daSTAT != null) daSTAT.visible = false;
            }
        }
        FunkinSound.playOnce(Paths.sound("staticBUZZ"), 0.6);
    }

    public static function triggerStaticLoop(?camera:String = "camHUD", ?alpha:Float = 0.3, ?useRandomAlpha:Bool = true):Void {
        var doScreenStatic = Save.instance.modOptions["doScreenStatic"];
        if (!doScreenStatic) return;

        if (!isDaSTATCreated) {
            daSTAT = new FlxSprite(100, 0);
            daSTAT.frames = Paths.getSparrowAtlas("events/daSTAT");
            // loop the animation indefinitely
            daSTAT.animation.addByPrefix('static', 'staticFLASH', 30, true);
            daSTAT.scale.set(FlxG.onMobile ? 6.15 : 5, FlxG.onMobile ? 5.1 : 5);
            switch (camera) {
                case "camGame":
                    daSTAT.cameras = [PlayState.instance.camGame];
                case "camHUD":
                    daSTAT.cameras = [PlayState.instance.camHUD];
                case "camCutscene":
                    daSTAT.cameras = [PlayState.instance.camCutscene];
                default:
                    daSTAT.cameras = [PlayState.instance.camHUD];
            }
            daSTAT.zIndex = 5000;
            daSTAT.alpha = useRandomAlpha ? FlxG.random.float(0.1, 0.5) : alpha;
            daSTAT.visible = false;
            PlayState.instance.add(daSTAT);
            isDaSTATCreated = true;
        } else {
            daSTAT.animation.getByName('static').looped = true;
        }

        if (daSTAT != null) {
            daSTAT.visible = true;
            daSTAT.animation.play('static');
        }

        var buzz = FunkinSound.playOnce(Paths.sound("staticBUZZ"), 0.6);
        if (buzz != null) buzz.looped = true;
    }

    public static function stopStaticLoop():Void {
        if (daSTAT != null) {
            daSTAT.visible = false;
            daSTAT.animation.stop();
        }
    }

    public static var screenGlitch:FunkinSprite = null;
    public static var isScreenGlitchCreated:Bool = false;

    public static function triggerGlitchTransition():Void {
        if (!isScreenGlitchCreated) {
            screenGlitch = FunkinSprite.create(-600, -200);
            screenGlitch.frames = Paths.getSparrowAtlas('events/P3_Stat');
            screenGlitch.scrollFactor.set(1, 1);
            screenGlitch.scale.set(5.5, 5.5);
            screenGlitch.animation.addByPrefix('busk', 'Phase3Static instance 1', 34, false); // org. framerate is 36 // 24 (base game)
            screenGlitch.zIndex = 20;
		    screenGlitch.visible = false;
		    screenGlitch.animation.finishCallback = function() {
                if (screenGlitch != null) screenGlitch.visible = false;
            };
		    PlayState.instance.add(screenGlitch);
            isScreenGlitchCreated = true;
        }
        if (screenGlitch != null) {
            screenGlitch.visible = true;
            screenGlitch.animation.play('busk');
        }
    }

    public static function triggerCinematics():Void {
        doCinematics = Save.instance.modOptions["doCinematics"];
        if (!doCinematics) return;

        if (!isBordersCreated) {
            topBorder = new FlxSprite(0, -50).makeGraphic(FlxG.width, 50, 0xFF000000);
            topBorder.cameras = [PlayState.instance.camCutscene];
            topBorder.scale.set(5, 5);
            topBorder.alpha = 0;
            PlayState.instance.add(topBorder);

            bottomBorder = new FlxSprite(0, FlxG.height - 0).makeGraphic(FlxG.width, 50, 0xFF000000);
            bottomBorder.cameras = [PlayState.instance.camCutscene];
            bottomBorder.scale.set(5, 5);
            bottomBorder.alpha = 0;
            PlayState.instance.add(bottomBorder);
            isBordersCreated = true;
        }

        if (topBorder != null && bottomBorder != null) {
            FlxTween.tween(topBorder, {alpha: 1}, 1);
            FlxTween.tween(bottomBorder, {alpha: 1}, 1);
            PlayState.instance.camHUD.alpha = 0;
        }
    }

    public static function disableCinematics():Void {
        doCinematics = Save.instance.modOptions["doCinematics"];
        if (!doCinematics) return;

        if (isBordersCreated && topBorder != null && bottomBorder != null) {
            FlxTween.tween(topBorder, {alpha: 0}, 1);
            FlxTween.tween(bottomBorder, {alpha: 0}, 1);
            PlayState.instance.camHUD.alpha = 1;
        }
    }

    public static var sonicJumpAnim:FunkinSprite;

    public static function triggerAnimatedJumpscare():Void {
        doJumpscares = Save.instance.modOptions["doJumpscares"];
        if (!doJumpscares) return;

        sonicJumpAnim = FunkinSprite.createSparrow(0, 0, "events/jumpscares/sonicJUMPSCARE");
        sonicJumpAnim.setPosition(FlxG.onMobile ? 200 : 150, 115);
        sonicJumpAnim.animation.addByPrefix('spook', 'sonicSPOOK', 24, false); // org. framerate is 36 // 24 (base game)
        sonicJumpAnim.animation.play('spook');
		sonicJumpAnim.cameras = [PlayState.instance.camCutscene];
		sonicJumpAnim.animation.finishCallback = function() {
            if (sonicJumpAnim != null) sonicJumpAnim.visible = false;
        };
		PlayState.instance.add(sonicJumpAnim);

		FunkinSound.playOnce(Paths.sound("datOneSound"), 1);
        var jumpSound = FunkinSound.playOnce(Paths.sound("jumpscare"), 0.7);
        FlxTween.tween(jumpSound, {volume: 0}, 2.3);
    }

    public static var sonicJump:FunkinSprite = null;
    public static var tailsJump:FunkinSprite = null;
	public static var knucklesJump:FunkinSprite = null;
	public static var eggmanJump:FunkinSprite = null;
    public static var shadow:FunkinSprite = null;

    public static function triggerJumpscare(type:String):Void {
        doJumpscares = Save.instance.modOptions["doJumpscares"];
        if (!doJumpscares) return;

        if (blackBG == null) {
            blackBG = new FlxSprite(0, 0);
            blackBG.makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
            blackBG.scrollFactor.set();
            blackBG.cameras = [PlayState.instance.camCutscene];
            blackBG.zIndex = 5000;
            PlayState.instance.add(blackBG);
            blackBG.alpha = 0;
        }

        switch (type) {
            case "sonic":
                if (sonicJump == null) { // prevent from being created multiple times
                    sonicJump = FunkinSprite.create(FlxG.onMobile ? 200 : 0, 0, "events/jumpscares/Sonic");
                    sonicJump.cameras = [PlayState.instance.camCutscene];
                    sonicJump.zIndex = 5001;
                    sonicJump.visible = false;
                    PlayState.instance.add(sonicJump);
                }

                sonicJump.visible = true;
                blackBG.alpha = 1;
                new FlxTimer().start(0.3, function(timer:FlxTimer) {
				    if (sonicJump != null) sonicJump.visible = false;
                    if (blackBG != null) blackBG.alpha = 0;
			    });
			    FunkinSound.playOnce(Paths.sound("sppok"), 1);
                return;
            case "tails":
                if (tailsJump == null) {
                    tailsJump = FunkinSprite.create(FlxG.onMobile ? 200 : 0, 0, 'events/jumpscares/Tails');
                    tailsJump.cameras = [PlayState.instance.camCutscene];
                    tailsJump.zIndex = 5001;
                    tailsJump.alpha = 0;
                    PlayState.instance.add(tailsJump);
                }

                tailsJump.alpha = 1;
				FlxTween.tween(tailsJump, { alpha: 0 }, 1.5);
				var tailsScream = FunkinSound.playOnce(Paths.sound("TailsScreamLOL"), 0.4);
				FlxTween.tween(tailsScream, {volume: 0}, 1.5);
                blackBG.alpha = 1;
		        FlxTween.tween(blackBG, { alpha: 0 }, 1.5);
                return;
            case "knuckles":
                if (knucklesJump == null) {
                    knucklesJump = FunkinSprite.create(FlxG.onMobile ? 200 : 0, 0, 'events/jumpscares/Knuckles');
                    knucklesJump.cameras = [PlayState.instance.camCutscene];
                    knucklesJump.zIndex = 5001;
                    knucklesJump.alpha = 0;
                    PlayState.instance.add(knucklesJump);
                }

                knucklesJump.alpha = 1;
				FlxTween.tween(knucklesJump, { alpha: 0 }, 1.5);
				var knucklesScream = FunkinSound.playOnce(Paths.sound("KnucklesScreamLOL"), 0.4);
				FlxTween.tween(knucklesScream, {volume: 0}, 1.5);
                blackBG.alpha = 1;
		        FlxTween.tween(blackBG, { alpha: 0 }, 1.5);
                return;
            case "eggman":
                if (eggmanJump == null) {
                    eggmanJump = FunkinSprite.create(FlxG.onMobile ? 200 : 0, 0, 'events/jumpscares/Eggman');
                    eggmanJump.cameras = [PlayState.instance.camCutscene];
                    eggmanJump.zIndex = 5001;
                    eggmanJump.alpha = 0;
                    PlayState.instance.add(eggmanJump);
                }

                eggmanJump.alpha = 1;
                FlxTween.tween(eggmanJump, { alpha: 0 }, 1.5);
                var eggmanScream = FunkinSound.playOnce(Paths.sound("EggmanScreamLOL"), 0.4);
                FlxTween.tween(eggmanScream, {volume: 0}, 1.5);
                blackBG.alpha = 1;
		        FlxTween.tween(blackBG, { alpha: 0 }, 1.5);
                return;
            case "shadow":
                if (shadow == null) { // prevent from being created multiple times
                    shadow = FunkinSprite.create(FlxG.onMobile ? 200 : 0, 0, "events/jumpscares/SHADOWTHEFUCKINGHEDGEHOG");
                    shadow.cameras = [PlayState.instance.camCutscene];
                    shadow.zIndex = 5001;
                    shadow.alpha = 0;
                    PlayState.instance.add(shadow);
                }
                shadow.alpha = 1;
                FlxTween.tween(shadow, {alpha: 0}, 1.5);
                var vineBoom = FunkinSound.playOnce(Paths.sound("vboom"), 0.8);
                FlxTween.tween(blackBG, { alpha: 0 }, 0.0000001);
            default:
                return;
        }
    }

    override function onSongRetry():Void {
        super.onSongRetry();

        disableCinematics();
    }

    public override function onDestroy(e):Void {
        super.onDestroy(e);
        resetVariables();
    }
}