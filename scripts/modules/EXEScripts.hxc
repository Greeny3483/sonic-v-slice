import flixel.FlxG;
import flixel.FlxSprite;
import flixel.util.FlxTimer;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.Paths;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.FunkinMemory;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.modding.module.Module;
import funkin.util.ReflectUtil;

import EXEHud;

class EXEScripts extends Module {
    // This module handles scripted events for various songs (ex, jumpscares)

    public function new() {
        super("EXEScripts");
    }

    public static var daSTAT:FlxSprite = null;
    public static var topBorder:FlxSprite = null;
    public static var bottomBorder:FlxSprite = null;
    public static var blackBG:FlxSprite = null;
    public static var screenGlitch:FunkinSprite = null;
    public static var redVignette:FlxSprite = null;
    public static var sonicJumpAnim:FunkinSprite = null;

    public static var sonicJump:FunkinSprite = null;
    public static var tailsJump:FunkinSprite = null;
    public static var knucklesJump:FunkinSprite = null;
    public static var eggmanJump:FunkinSprite = null;
    public static var shadow:FunkinSprite = null;

    public static var areStrumlinesMoved:Bool = false;
    public static var lastStrumlineOffset:Float = 0;

    static function getCamera(camera:String) {
        return switch (camera) {
            case "camGame": PlayState.instance.camGame;
            case "camHUD": PlayState.instance.camHUD;
            case "camCutscene": PlayState.instance.camCutscene;
            default: PlayState.instance.camHUD;
        };
    }

    public static function resetVariables():Void {
        daSTAT = null;
        topBorder = null;
        bottomBorder = null;
        blackBG = null;
        screenGlitch = null;
        redVignette = null;
        sonicJumpAnim = null;
        sonicJump = null;
        tailsJump = null;
        knucklesJump = null;
        eggmanJump = null;
        shadow = null;
        areStrumlinesMoved = false;
        lastStrumlineOffset = 0;
    }

    override function onSongLoaded(event):Void {
        super.onSongLoaded(event);
        resetVariables();

        var images:Array<String> = [
            "events/jumpscares/sonicJUMPSCARE", "events/jumpscares/Sonic", "events/jumpscares/Tails",
            "events/jumpscares/Knuckles", "events/jumpscares/Eggman", "events/jumpscares/SHADOWTHEFUCKINGHEDGEHOG",
            "events/daSTAT", "events/RedVG", "events/P3_Stat"
        ];
        for (img in images) FunkinMemory.cacheTexture(Paths.image(img));

        var sounds:Array<String> = [
            "TailsScreamLOL", "KnucklesScreamLOL", "EggmanScreamLOL", "datOneSound",
            "jumpscare", "sppok", "vboom", "staticBUZZ"
        ];
        for (snd in sounds) FunkinMemory.cacheSound(Paths.sound(snd, "shared"));

        Paths.getSparrowAtlas("events/jumpscares/sonicJUMPSCARE");
    }

    static function prepareStatic(camera:String, alpha:Float, useRandomAlpha:Bool, looped:Bool):Void {
        if (!Save.instance.modOptions["doScreenStatic"]) return;

        if (daSTAT == null) {
            daSTAT = new FlxSprite();
            daSTAT.frames = Paths.getSparrowAtlas("events/daSTAT");
            daSTAT.animation.addByPrefix('static', 'staticFLASH', 30, looped);
            daSTAT.setGraphicSize(FlxG.width, FlxG.height);
            daSTAT.updateHitbox();
            daSTAT.screenCenter();
            daSTAT.cameras = [getCamera(camera)];
            daSTAT.zIndex = 5000;
            daSTAT.alpha = useRandomAlpha ? FlxG.random.float(0.1, 0.5) : alpha;
            daSTAT.visible = false;
            PlayState.instance.add(daSTAT);
        } else {
            daSTAT.animation.getByName('static').looped = looped;
        }

        if (daSTAT != null) {
            daSTAT.visible = true;
            daSTAT.animation.play('static');
        }
    }

    public static function triggerStatic(?camera:String = "camHUD", ?alpha:Float = 0.3, ?useRandomAlpha:Bool = true):Void {
        prepareStatic(camera, alpha, useRandomAlpha, false);
        if (daSTAT != null) {
            daSTAT.animation.finishCallback = function(_) {
                if (daSTAT != null) daSTAT.visible = false;
            };
        }
        FunkinSound.playOnce(Paths.sound("staticBUZZ"), 0.6);
    }

    public static function triggerStaticLoop(?camera:String = "camHUD", ?alpha:Float = 0.3, ?useRandomAlpha:Bool = true):Void {
        prepareStatic(camera, alpha, useRandomAlpha, true);
        var buzz = FunkinSound.playOnce(Paths.sound("staticBUZZ"), 0.6);
        if (buzz != null) buzz.looped = true;
    }

    public static function stopStaticLoop():Void {
        if (daSTAT != null) {
            daSTAT.visible = false;
            daSTAT.animation.stop();
        }
    }

    public static function triggerGlitchTransition():Void {
        if (screenGlitch == null) {
            screenGlitch = FunkinSprite.create(-600, -200);
            screenGlitch.frames = Paths.getSparrowAtlas('events/P3_Stat');
            screenGlitch.scrollFactor.set(1, 1);
            screenGlitch.scale.set(5.5, 5.5);
            screenGlitch.animation.addByPrefix('busk', 'Phase3Static instance 1', 34, false);
            screenGlitch.zIndex = 20;
            screenGlitch.visible = false;
            screenGlitch.animation.finishCallback = function() {
                if (screenGlitch != null) screenGlitch.visible = false;
            };
            PlayState.instance.add(screenGlitch);
        }
        if (screenGlitch != null) {
            screenGlitch.visible = true;
            screenGlitch.animation.play('busk');
        }
    }

    static function setupSprite(sprite:FunkinSprite, zIndex:Int):Void {
        sprite.screenCenter();
        sprite.cameras = [PlayState.instance.camCutscene];
        sprite.zIndex = zIndex;
        PlayState.instance.add(sprite);
    }

    static function tweenHUD(alpha:Float, duration:Float):Void {
        var elements = [
            PlayState.instance.healthBar, PlayState.instance.healthBarBG,
            PlayState.instance.iconP1, PlayState.instance.iconP2,
            PlayState.instance.scoreText, EXEHud.sonicMissesSprite,
            EXEHud.sonicTimeSprite, EXEHud.sonicScoreSprite,
            EXEHud.sonicColonSprite, EXEHud.sonicHealthSprite
        ];
        for (e in elements) if (e != null) FlxTween.tween(e, {alpha: alpha}, duration);

        var groupElements = [
            EXEHud.missesNumbers, EXEHud.timeNumbers,
            EXEHud.scoreNumbers, EXEHud.healthNumbers
        ];
        for (group in groupElements) {
            if (group != null) for (num in group) if (num != null) FlxTween.tween(num, {alpha: alpha}, duration);
        }
    }

    public static function triggerCinematics(?size:Float = 100, ?duration:Float = 1, ?tweenType:String = "fade", ?hideHUD:Bool = true, ?keepStrumlines:Bool = true):Void {
        if (!Save.instance.modOptions["doCinematics"]) return;

        if (topBorder == null) {
            topBorder = createBorder(0, 0, size);
            bottomBorder = createBorder(0, FlxG.height - size, size);
        } else {
            topBorder.makeGraphic(FlxG.width, Std.int(size), 0xFF000000);
            bottomBorder.makeGraphic(FlxG.width, Std.int(size), 0xFF000000);
            topBorder.alpha = bottomBorder.alpha = 0;
        }

        switch (tweenType) {
            case "fade":
                topBorder.y = 0;
                bottomBorder.y = FlxG.height - size;
                FlxTween.tween(topBorder, {alpha: 1}, duration);
                FlxTween.tween(bottomBorder, {alpha: 1}, duration);
            case "slide":
                topBorder.alpha = bottomBorder.alpha = 1;
                topBorder.y = -size;
                bottomBorder.y = FlxG.height;
                FlxTween.tween(topBorder, {y: 0}, duration, {ease: FlxEase.quadOut});
                FlxTween.tween(bottomBorder, {y: FlxG.height - size}, duration, {ease: FlxEase.quadOut});
            case "instant":
                topBorder.alpha = bottomBorder.alpha = 1;
                topBorder.y = 0;
                bottomBorder.y = FlxG.height - size;
        }
        
        if (hideHUD) {
            if (PlayState.instance.camHUD != null) {
                if (tweenType == "instant") PlayState.instance.camHUD.alpha = 0;
                else FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, duration);
            }
            if (areStrumlinesMoved) {
                moveStrumlines(-lastStrumlineOffset, duration, tweenType);
                areStrumlinesMoved = false;
                lastStrumlineOffset = 0;
            }
        } else {
            if (tweenType == "instant") {
                // Instantly update elements handled by tweenHUD
                var elements = [
                    PlayState.instance.healthBar, PlayState.instance.healthBarBG,
                    PlayState.instance.iconP1, PlayState.instance.iconP2,
                    PlayState.instance.scoreText, EXEHud.sonicMissesSprite,
                    EXEHud.sonicTimeSprite, EXEHud.sonicScoreSprite,
                    EXEHud.sonicColonSprite, EXEHud.sonicHealthSprite
                ];
                for (e in elements) if (e != null) e.alpha = 0;

                var groupElements = [
                    EXEHud.missesNumbers, EXEHud.timeNumbers,
                    EXEHud.scoreNumbers, EXEHud.healthNumbers
                ];
                for (group in groupElements) {
                    if (group != null) for (num in group) if (num != null) num.alpha = 0;
                }
            } else {
                tweenHUD(0, duration);
            }

            if (!FlxG.onMobile && keepStrumlines) {
                var offset:Float = (Preferences.downscroll ? -1 : 1) * (size - 30);
                if (areStrumlinesMoved) {
                    moveStrumlines(offset - lastStrumlineOffset, duration, tweenType);
                } else {
                    moveStrumlines(offset, duration, tweenType);
                    areStrumlinesMoved = true;
                }
                lastStrumlineOffset = offset;
            } else if (areStrumlinesMoved) {
                moveStrumlines(-lastStrumlineOffset, duration, tweenType);
                areStrumlinesMoved = false;
                lastStrumlineOffset = 0;
            }
        }
    }

    static function moveStrumlines(offset:Float, duration:Float, tweenType:String):Void {
        if (tweenType == "instant") {
            PlayState.instance.playerStrumline.y += offset;
            PlayState.instance.opponentStrumline.y += offset;
        } else {
            FlxTween.tween(PlayState.instance.playerStrumline, {y: PlayState.instance.playerStrumline.y + offset}, duration, {ease: FlxEase.quadOut});
            FlxTween.tween(PlayState.instance.opponentStrumline, {y: PlayState.instance.opponentStrumline.y + offset}, duration, {ease: FlxEase.quadOut});
        }
    }

    static function createBorder(x:Float, y:Float, size:Float):FlxSprite {
        var border = new FlxSprite(x, y).makeGraphic(FlxG.width, Std.int(size), 0xFF000000);
        border.cameras = [PlayState.instance.camCutscene];
        border.alpha = 0;
        PlayState.instance.add(border);
        return border;
    }

    public static function disableCinematics(?duration:Float = 1, ?tweenType:String = "fade"):Void {
        if (!Save.instance.modOptions["doCinematics"] || topBorder == null) return;

        var size:Float = topBorder.height;
        switch (tweenType) {
            case "fade":
                FlxTween.tween(topBorder, {alpha: 0}, duration);
                FlxTween.tween(bottomBorder, {alpha: 0}, duration);
            case "slide":
                FlxTween.tween(topBorder, {y: -size}, duration, {ease: FlxEase.quadIn, onComplete: function(_) { topBorder.alpha = 0; }});
                FlxTween.tween(bottomBorder, {y: FlxG.height}, duration, {ease: FlxEase.quadIn, onComplete: function(_) { bottomBorder.alpha = 0; }});
            case "instant":
                topBorder.alpha = bottomBorder.alpha = 0;
        }
        
        if (PlayState.instance.camHUD != null) {
            if (tweenType == "instant") PlayState.instance.camHUD.alpha = 1;
            else FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, duration);
        }

        if (tweenType == "instant") {
            var elements = [
                PlayState.instance.healthBar, PlayState.instance.healthBarBG,
                PlayState.instance.iconP1, PlayState.instance.iconP2,
                PlayState.instance.scoreText, EXEHud.sonicMissesSprite,
                EXEHud.sonicTimeSprite, EXEHud.sonicScoreSprite,
                EXEHud.sonicColonSprite, EXEHud.sonicHealthSprite
            ];
            for (e in elements) if (e != null) e.alpha = 1;

            var groupElements = [
                EXEHud.missesNumbers, EXEHud.timeNumbers,
                EXEHud.scoreNumbers, EXEHud.healthNumbers
            ];
            for (group in groupElements) {
                if (group != null) for (num in group) if (num != null) num.alpha = 1;
            }
        } else {
            tweenHUD(1, duration);
        }

        if (areStrumlinesMoved && !FlxG.onMobile) {
            if (tweenType == "instant") {
                PlayState.instance.playerStrumline.y -= lastStrumlineOffset;
                PlayState.instance.opponentStrumline.y -= lastStrumlineOffset;
            } else {
                FlxTween.tween(PlayState.instance.playerStrumline, {y: PlayState.instance.playerStrumline.y - lastStrumlineOffset}, duration, {ease: FlxEase.quadIn});
                FlxTween.tween(PlayState.instance.opponentStrumline, {y: PlayState.instance.opponentStrumline.y - lastStrumlineOffset}, duration, {ease: FlxEase.quadIn});
            }
            areStrumlinesMoved = false;
            lastStrumlineOffset = 0;
        }
    }

    public static function triggerAnimatedJumpscare():Void {
        if (!Save.instance.modOptions["doJumpscares"]) return;

        if (sonicJumpAnim == null) {
            sonicJumpAnim = FunkinSprite.createSparrow(150, 115, "events/jumpscares/sonicJUMPSCARE");
            sonicJumpAnim.animation.addByPrefix('spook', 'sonicSPOOK', 24, false);
            sonicJumpAnim.cameras = [PlayState.instance.camCutscene];
            sonicJumpAnim.animation.finishCallback = function() {
                if (sonicJumpAnim != null) sonicJumpAnim.visible = false;
            };
            PlayState.instance.add(sonicJumpAnim);
        }

        sonicJumpAnim.visible = true;
        //sonicJumpAnim.screenCenter();
        sonicJumpAnim.animation.play('spook');

        FunkinSound.playOnce(Paths.sound("datOneSound"), 1);
        var jumpSound = FunkinSound.playOnce(Paths.sound("jumpscare"), 0.7);
        if (jumpSound != null) FlxTween.tween(jumpSound, {volume: 0}, 2.3);
    }

    public static function triggerJumpscare(type:String):Void {
        if (!Save.instance.modOptions["doJumpscares"]) return;

        if (blackBG == null) {
            blackBG = new FlxSprite(0, 0).makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
            blackBG.scrollFactor.set();
            blackBG.cameras = [PlayState.instance.camCutscene];
            blackBG.zIndex = 5000;
            blackBG.alpha = 0;
            PlayState.instance.add(blackBG);
        }

        if (type == "sonic") {
            if (sonicJump == null) {
                sonicJump = FunkinSprite.create(0, 0, "events/jumpscares/Sonic");
                setupSprite(sonicJump, 5001);
                sonicJump.visible = false;
            }
            sonicJump.visible = true;
            blackBG.alpha = 1;
            new FlxTimer().start(0.3, function(timer:FlxTimer) {
                if (sonicJump != null) sonicJump.visible = false;
                if (blackBG != null) blackBG.alpha = 0;
            });
            FunkinSound.playOnce(Paths.sound("sppok"), 1);
            return;
        }

        var sprite:FunkinSprite = null;
        var sound:String = "";
        var soundVol:Float = 0.4;
        var bgAlphaDuration:Float = 1.5;

        switch (type) {
            case "tails":
                if (tailsJump == null) {
                    tailsJump = FunkinSprite.create(0, 0, 'events/jumpscares/Tails');
                    setupSprite(tailsJump, 5001);
                    tailsJump.alpha = 0;
                }
                sprite = tailsJump;
                sound = "TailsScreamLOL";
            case "knuckles":
                if (knucklesJump == null) {
                    knucklesJump = FunkinSprite.create(0, 0, 'events/jumpscares/Knuckles');
                    setupSprite(knucklesJump, 5001);
                    knucklesJump.alpha = 0;
                }
                sprite = knucklesJump;
                sound = "KnucklesScreamLOL";
            case "eggman":
                if (eggmanJump == null) {
                    eggmanJump = FunkinSprite.create(0, 0, 'events/jumpscares/Eggman');
                    setupSprite(eggmanJump, 5001);
                    eggmanJump.alpha = 0;
                }
                sprite = eggmanJump;
                sound = "EggmanScreamLOL";
            case "shadow":
                if (shadow == null) {
                    shadow = FunkinSprite.create(0, 0, "events/jumpscares/SHADOWTHEFUCKINGHEDGEHOG");
                    setupSprite(shadow, 5001);
                    shadow.alpha = 0;
                }
                sprite = shadow;
                sound = "vboom";
                soundVol = 0.8;
                bgAlphaDuration = 0.0000001;
        }

        if (sprite != null) {
            sprite.alpha = 1;
            FlxTween.tween(sprite, {alpha: 0}, 1.5);
            var snd = FunkinSound.playOnce(Paths.sound(sound), soundVol);
            if (snd != null) FlxTween.tween(snd, {volume: 0}, 1.5);
            blackBG.alpha = 1;
            FlxTween.tween(blackBG, {alpha: 0}, bgAlphaDuration);
        }
    }

    override function onSongRetry():Void {
        super.onSongRetry();

        disableCinematics();
    }

    public override function onDestroy(e):Void {
        super.onDestroy(e);
        resetVariables();
    }
}