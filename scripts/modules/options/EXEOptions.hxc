import funkin.modding.module.Module;
import Std;
import funkin.ui.options.OptionsState;
import flixel.FlxG;
import funkin.play.PlayState;
import Type;
import funkin.util.ReflectUtil;
import funkin.util.Constants;
import funkin.play.character.CharacterDataParser;
import funkin.play.character.BaseCharacter;
import funkin.ui.PixelatedIcon;
import funkin.ui.freeplay.SongMenuItem;
import funkin.ui.freeplay.FreeplayState;
import funkin.PlayerSettings;
import funkin.save.Save;
import funkin.modding.module.ModuleHandler;

class EXEOptions extends Module
{
    // Gameplay
    public var doJumpscares:Bool = true;
    public var doCameraShakes:Bool = true;
    public var doScreenStatic:Bool = true;
    public var doModcharts:Bool = true;
    public var doStrumSwap:Bool = true;
    public var doQTES:Bool = true;
    public var doCinematics:Bool = true;
    public var doFatalPopups:Bool = true;
    public var doWindowMovement:Bool = true;
    public var doGhostTapping:Bool = true;
    public var doSongTransitions:Bool = true;
    public var doCamMovement:Bool = true;
    public var camMovementIntensity:Int = 20;

    // Graphics
    public var allowGore:Bool = true;
    public var doShaders:Bool = true;

    // HUD
    public var doGenesisHUD:Bool = true;
    public var doColoredHealthBar:Bool = true;

    // Menu
    public var freeplayBG:String = "Dad";

    // Bonus Content
    public var doGenesisMode:Bool = false;


    public function new(){
        super("EXEOptions", 1);

        // Gameplay
        if(Save.instance.modOptions["doJumpscares"] == null) Save.instance.modOptions["doJumpscares"] = true;
        if(Save.instance.modOptions["doCameraShakes"] == null) Save.instance.modOptions["doCameraShakes"] = true;
        if(Save.instance.modOptions["doScreenStatic"] == null) Save.instance.modOptions["doScreenStatic"] = true;
        if(Save.instance.modOptions["doModcharts"] == null) Save.instance.modOptions["doModcharts"] = true;
        if(Save.instance.modOptions["doQTES"] == null) Save.instance.modOptions["doQTES"] = true;
        if(Save.instance.modOptions["doCinematics"] == null) Save.instance.modOptions["doCinematics"] = true;
        if(Save.instance.modOptions["doFatalPopups"] == null) Save.instance.modOptions["doFatalPopups"] = true;
        if(Save.instance.modOptions["doWindowMovement"] == null) Save.instance.modOptions["doWindowMovement"] = true;
        if(Save.instance.modOptions["doGhostTapping"] == null) Save.instance.modOptions["doGhostTapping"] = true;
        if(Save.instance.modOptions["doSongTransitions"] == null) Save.instance.modOptions["doSongTransitions"] = true;
        if(Save.instance.modOptions["doCamMovement"] == null) Save.instance.modOptions["doCamMovement"] = true;
        if(Save.instance.modOptions["camMovementIntensity"] == null) Save.instance.modOptions["camMovementIntensity"] = 20;

        // Graphics
        if(Save.instance.modOptions["allowGore"] == null) Save.instance.modOptions["allowGore"] = true;
        if(Save.instance.modOptions["doShaders"] == null) Save.instance.modOptions["doShaders"] = true;

        // HUD
        if(Save.instance.modOptions["doGenesisHUD"] == null) Save.instance.modOptions["doGenesisHUD"] = true;
        if(Save.instance.modOptions["doColoredHealthBar"] == null) Save.instance.modOptions["doColoredHealthBar"] = true;

        // Menu
        if(Save.instance.modOptions["freeplayBG"] == null) Save.instance.modOptions["freeplayBG"] = "Dad";

        // Bonus Content
        if(Save.instance.modOptions["doGenesisMode"] == null) Save.instance.modOptions["doGenesisMode"] = false;
    }

    public var inOptions:Bool = false;

    override function onStateChangeEnd(event){
        super.onStateChangeEnd(event);
        inOptions = false;
        if(Std.isOfType(event.targetState, OptionsState)){
            var prefs = event.targetState.optionsCodex.pages.get("preferences");
            inOptions = true;

            prefs.items.createItem(120, 120 * prefs.items.length + 30, "EXE: GAMEPLAY", "bold", () -> false); // Separate options from the default preferences OR modded preferences.
			prefs.preferenceDesc.push("Gameplay options for VS Sonic.EXE");

            prefs.createPrefItemCheckbox("Jumpscares", "Toggles jumpscares.", function(value) {
                Save.instance.modOptions["doJumpscares"] = value;
                doJumpscares = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doJumpscares"]);

            prefs.createPrefItemCheckbox("Camera Shake", "Toggles camera shakes.", function(value) {
                Save.instance.modOptions["doCameraShakes"] = value;
                doCameraShakes = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doCameraShakes"]);

            prefs.createPrefItemCheckbox("Screen Static", "Toggles screen static effects.", function(value) {
                Save.instance.modOptions["doScreenStatic"] = value;
                doScreenStatic = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doScreenStatic"]);

            prefs.createPrefItemCheckbox("Modcharts", "Toggles modchart effects such as strumline wiggle.", function(value) {
                Save.instance.modOptions["doModcharts"] = value;
                doModcharts = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doModcharts"]);

            prefs.createPrefItemCheckbox("QTEs", "Toggles quick time events.", function(value) {
                Save.instance.modOptions["doQTES"] = value;
                doQTES = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doQTES"]);

            prefs.createPrefItemCheckbox("Cinematics", "Toggles cinematic effects.", function(value) {
                Save.instance.modOptions["doCinematics"] = value;
                doCinematics = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doCinematics"]);

            prefs.createPrefItemCheckbox("Fatal Error Popups", "Toggles the 'Fatality Popups' event.", function(value) {
                Save.instance.modOptions["doFatalPopups"] = value;
                doFatalPopups = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doFatalPopups"]);

            prefs.createPrefItemCheckbox("Window Movement", "Toggles window movement effects.", function(value) {
                Save.instance.modOptions["doWindowMovement"] = value;
                doWindowMovement = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doWindowMovement"]);

            prefs.createPrefItemCheckbox("Ghost Tapping", "Toggles ghost tapping.", function(value) {
                Save.instance.modOptions["doGhostTapping"] = value;
                doGhostTapping = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doGhostTapping"]);

            prefs.createPrefItemCheckbox("Song Transitions", "Toggles movement of the camera when hitting a note.", function(value) {
                Save.instance.modOptions["doSongTransitions"] = value;
                doSongTransitions = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doSongTransitions"]);

            prefs.createPrefItemCheckbox("Camera Movement", "Toggles movement of the camera when hitting a note.", function(value) {
                Save.instance.modOptions["doCamMovement"] = value;
                doCamMovement = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doCamMovement"]);

            prefs.createPrefItemNumber(
                "Intensity",
                "How far the camera moves when hitting a note.",
                function(value:Float) {
                    if (Save.instance.modOptions["camMovementIntensity"]) {
                        Save.instance.modOptions["camMovementIntensity"] = Std.int(value);
                        camMovementIntensity = Std.int(value);
                        Save.instance.flush();
                    }
                },
                null,
                Save.instance.modOptions["camMovementIntensity"],
                5, 100, 5, 0
            );

            prefs.items.createItem(120, 120 * prefs.items.length + 30, "EXE: GRAPHICS", "bold", () -> false);
			prefs.preferenceDesc.push("Graphical options for VS Sonic.EXE");

            prefs.createPrefItemCheckbox("Gore", "Toggles gore assets.", function(value) {
                Save.instance.modOptions["allowGore"] = value;
                allowGore = value;
                Save.instance.flush();
            }, Save.instance.modOptions["allowGore"]);

            prefs.createPrefItemCheckbox("Shaders", "Toggles shaders. Disabling may improve performance.", function(value) {
                Save.instance.modOptions["doShaders"] = value;
                doShaders = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doShaders"]);

            prefs.items.createItem(120, 120 * prefs.items.length + 30, "EXE: HUD", "bold", () -> false);
            prefs.preferenceDesc.push("HUD options for VS Sonic.EXE");

            prefs.createPrefItemCheckbox("Genesis HUD", "Toggles the genesis-styled HUD.", function(value) {
                Save.instance.modOptions["doGenesisHUD"] = value;
                doGenesisHUD = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doGenesisHUD"]);

            prefs.createPrefItemCheckbox("Colored Health Bar", "Toggles icon based health bar colors.", function(value) {
                Save.instance.modOptions["doColoredHealthBar"] = value;
                doColoredHealthBar = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doColoredHealthBar"]);

            prefs.items.createItem(120, 120 * prefs.items.length + 30, "EXE: MENU", "bold", () -> false);
			prefs.preferenceDesc.push("Menu options for VS Sonic.EXE");

            prefs.createPrefItemEnum("Freeplay BG", "Switch between different freeplay backgrounds.", [
                "Default" => "Default",
                "Too Slow" => "Too Slow",
                "You Can't Run" => "You Can't Run",
				"Triple Trouble" => "Triple Trouble",
				"Endless" => "Endless",
				"Cycles" => "Cycles",
				"Faker" => "Faker",
				"Relax" => "Relax",
				"Prey" => "Prey",
				"Fatality" => "Fatality",
                "Personnel" => "Personnel",
                "Soulless" => "Soulless",
                "Fight or Flight" => "Fight or Flight"
			], function(key:String, value:String) {
				Save.instance.modOptions["freeplayBG"] = value;
				exebackingCard = value;
				Save.instance.flush();
			}, Save.instance.modOptions["freeplayBG"]);

            prefs.items.createItem(120, 120 * prefs.items.length + 30, "EXE: EXTRAS", "bold", () -> false);
            prefs.preferenceDesc.push("Bonus content options for VS Sonic.EXE");

            prefs.createPrefItemCheckbox("Genesis Mode", "Toggles extra visuals not typically seen in some songs.", function(value) {
                Save.instance.modOptions["doGenesisMode"] = value;
                doGenesisMode = value;
                Save.instance.flush();
            }, Save.instance.modOptions["doGenesisMode"]);
        }
    }
}
