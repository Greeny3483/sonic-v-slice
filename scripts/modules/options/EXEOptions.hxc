import funkin.modding.module.Module;
import Std;
import funkin.ui.options.OptionsState;
import funkin.ui.options.PreferencesMenu;
import flixel.FlxG;
import funkin.save.Save;
import funkin.modding.events.ScriptEvent;

class EXEOptions extends Module
{
    // Gameplay
    public var doJumpscares:Bool = true;
    public var doCameraShakes:Bool = true;
    public var doScreenStatic:Bool = true;
    public var doModcharts:Bool = true;
    public var doCinematics:Bool = true;
    public var doRingMechanic:Bool = true;
    public var doFatalPopups:Bool = true;
    public var doWindowMovement:Bool = true;
    public var doGhostTapping:Bool = true;
    public var doCamMovement:Bool = true;
    public var camMovementIntensity:Int = 20;

    // Graphics
    public var allowGore:Bool = true;
    public var doShaders:Bool = true;

    // HUD
    public var doGenesisHUD:Bool = true;
    public var showHealthText:Bool = false;
    public var doColoredHealthBar:Bool = true;
    public var timerMode:String = "Count Up";

    // UI
    public var doEXETitleIntro:Bool = false;
    public var doEXETitleScreen:Bool = false;
    public var doEXEMenuScreen:Bool = false;
    public var freeplayBG:String = "Dad";

    // MISC
    public var doSongTransitions:Bool = true;
    public var doFreeplayCuts:Bool = false;
    public var doGenesisMode:Bool = false;

    private var optionForMobile:Map<String, Bool> = [
        "doJumpscares" => true,
        "doCameraShakes" => true,
        "doScreenStatic" => true,
        "doModcharts" => true,
        "doCinematics" => false,
        "doRingMechanic" => true,
        "doFatalPopups" => true,
        "doWindowMovement" => false,
        "doGhostTapping" => false,
        "doSongTransitions" => true,
        "doFreeplayCuts" => true,
        "doCamMovement" => true,
        "camMovementIntensity" => true,
        "allowGore" => true,
        "doShaders" => true,
        "doGenesisHUD" => true,
        "doColoredHealthBar" => true,
        "doEXETitleIntro" => true,
        "doEXETitleScreen" => true,
        "doEXEMenuScreen" => true,
        "freeplayBG" => true,
        "doGenesisMode" => true,
        "timerMode" => true
    ];

    private function shouldShowOption(optionName:String, isMobile:Bool):Bool
    {
        if (!isMobile) return true;
        return optionForMobile.get(optionName) ?? true;
    }

    private function createCheckboxIfMobileAllowed(prefs:PreferencesMenu, optionName:String, label:String, description:String, callback:Dynamic, defaultValue:Bool):Void
    {
        if (shouldShowOption(optionName, FlxG.onMobile)) {
            prefs.createPrefItemCheckbox(label, description, callback, defaultValue);
        }
    }

    private function createNumberIfMobileAllowed(prefs:PreferencesMenu, optionName:String, label:String, description:String, callback:Dynamic, defaultValue:Dynamic, min:Int, max:Int, step:Int, decimals:Int):Void
    {
        if (shouldShowOption(optionName, FlxG.onMobile)) {
            prefs.createPrefItemNumber(label, description, callback, null, defaultValue, min, max, step, decimals);
        }
    }

    private function createEnumIfMobileAllowed(prefs:PreferencesMenu, optionName:String, label:String, description:String, options:Dynamic, callback:Dynamic, defaultValue:Dynamic):Void
    {
        if (shouldShowOption(optionName, FlxG.onMobile)) {
            prefs.createPrefItemEnum(label, description, options, callback, defaultValue);
        }
    }

    private function initSave(key:String, defaultValue:Dynamic):Void 
    {
        if (!Save.instance.modOptions.exists(key)) {
            Save.instance.modOptions.set(key, defaultValue);
        }
    }

    public function new() {
        super("EXEOptions", 1, {state: OptionsState});
        doShaders = FlxG.onMobile ? false : true;

        initSave("doJumpscares", true);
        initSave("doCameraShakes", true);
        initSave("doScreenStatic", true);
        initSave("doModcharts", true);
        initSave("doCinematics", true);
        initSave("doRingMechanic", true);
        initSave("doFatalPopups", true);
        initSave("doWindowMovement", true);
        initSave("doGhostTapping", true);
        initSave("doSongTransitions", true);
        initSave("doFreeplayCuts", false);
        initSave("doCamMovement", true);
        initSave("camMovementIntensity", 20);
        
        initSave("allowGore", true);
        initSave("doShaders", doShaders);
        
        initSave("doGenesisHUD", true);
        initSave("showHealthText", false);
        initSave("doColoredHealthBar", true);
        initSave("timerMode", "Count Up");
        
        initSave("doEXETitleIntro", false);
        initSave("doEXETitleScreen", false);
        initSave("doEXEMenuScreen", false);
        initSave("freeplayBG", "Dad");
        
        initSave("doGenesisMode", false);
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (!Std.isOfType(event.targetState, OptionsState)) return;
        
        addCustomCategory(event.targetState);
        populateOptions(event.targetState);
    }

    function addCustomCategory(state:OptionsState) {
        var prefs:PreferencesMenu = state.optionsCodex.addPage('exe-options', new PreferencesMenu());
        prefs.onExit.add(() -> {
            FlxG.state.optionsCodex.switchPage('options');
        });
        prefs.preferenceDesc = [];
        prefs.items.clear();	
        prefs.preferenceItems.clear();

        var optionspage = state.optionsCodex.pages.get('options');
        var exit = optionspage.items.getItem("LAG ADJUSTMENT") ?? null;
        var option = optionspage.createItem("EXE Options", () -> state.optionsCodex.switchPage('exe-options')); 
        
        if (exit != null) {
            optionspage.items.members.remove(option);
            optionspage.items.members.insert(optionspage.items.members.indexOf(exit), option);
        }
        for (i in 0...optionspage.items.length) {
            var item = optionspage.items.members[i];
            item.y = 100 + i * 100;
        }
    }

    function populateOptions(state:OptionsState) {
        var prefs:PreferencesMenu = state.optionsCodex.pages.get('exe-options');
        if (prefs == null) return;

        // GAMEPLAY
        prefs.items.createItem(120, 120 * prefs.items.length + 30, "GAMEPLAY:", "bold", () -> false);
        prefs.preferenceDesc.push("Gameplay options for VS Sonic.EXE");

        createCheckboxIfMobileAllowed(prefs, "doJumpscares", "Jumpscares", "Toggles jumpscares.", function(value:Bool) {
            Save.instance.modOptions.set("doJumpscares", value);
            doJumpscares = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doJumpscares"));

        createCheckboxIfMobileAllowed(prefs, "doCameraShakes", "Camera Shake", "Toggles camera shakes.", function(value:Bool) {
            Save.instance.modOptions.set("doCameraShakes", value);
            doCameraShakes = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doCameraShakes"));

        createCheckboxIfMobileAllowed(prefs, "doScreenStatic", "Screen Static", "Toggles screen static effects.", function(value:Bool) {
            Save.instance.modOptions.set("doScreenStatic", value);
            doScreenStatic = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doScreenStatic"));

        createCheckboxIfMobileAllowed(prefs, "doModcharts", "Modcharts", "Toggles modchart effects such as strumline wiggle.", function(value:Bool) {
            Save.instance.modOptions.set("doModcharts", value);
            doModcharts = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doModcharts"));

        createCheckboxIfMobileAllowed(prefs, "doCinematics", "Cinematics", "Toggles cinematic effects.", function(value:Bool) {
            Save.instance.modOptions.set("doCinematics", value);
            doCinematics = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doCinematics"));

        createCheckboxIfMobileAllowed(prefs, "doRingMechanic", "Ring Mechanic", "Toggles the ring mechanic. Most notably in Triple Trouble.", function(value:Bool) {
            Save.instance.modOptions.set("doRingMechanic", value);
            doRingMechanic = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doRingMechanic"));

        createCheckboxIfMobileAllowed(prefs, "doFatalPopups", "Fatal Error Popups", "Toggles the 'Fatality Popups' event.", function(value:Bool) {
            Save.instance.modOptions.set("doFatalPopups", value);
            doFatalPopups = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doFatalPopups"));

        createCheckboxIfMobileAllowed(prefs, "doWindowMovement", "Window Movement", "Toggles window movement effects.", function(value:Bool) {
            Save.instance.modOptions.set("doWindowMovement", value);
            doWindowMovement = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doWindowMovement"));

        createCheckboxIfMobileAllowed(prefs, "doGhostTapping", "Ghost Tapping", "Toggles ghost tapping.", function(value:Bool) {
            Save.instance.modOptions.set("doGhostTapping", value);
            doGhostTapping = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doGhostTapping"));

        createCheckboxIfMobileAllowed(prefs, "doCamMovement", "Camera Movement", "Toggles movement of the camera when hitting a note.", function(value:Bool) {
            Save.instance.modOptions.set("doCamMovement", value);
            doCamMovement = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doCamMovement"));

        createNumberIfMobileAllowed(prefs, "camMovementIntensity", "  Intensity", "How far the camera moves when hitting a note.", function(value:Float) {
            Save.instance.modOptions.set("camMovementIntensity", Std.int(value));
            camMovementIntensity = Std.int(value);
            Save.instance.flush();
        }, Save.instance.modOptions.get("camMovementIntensity"), 5, 100, 5, 0);

        // GRAPHICS
        prefs.items.createItem(120, 120 * prefs.items.length + 30, "GRAPHICS:", "bold", () -> false);
        prefs.preferenceDesc.push("Graphical options for VS Sonic.EXE");

        createCheckboxIfMobileAllowed(prefs, "allowGore", "Gore", "Toggles gore assets.", function(value:Bool) {
            Save.instance.modOptions.set("allowGore", value);
            allowGore = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("allowGore"));

        createCheckboxIfMobileAllowed(prefs, "doShaders", "Shaders", "Toggles shaders. Disabling may improve performance.", function(value:Bool) {
            Save.instance.modOptions.set("doShaders", value);
            doShaders = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doShaders"));

        // HUD
        prefs.items.createItem(120, 120 * prefs.items.length + 30, "HUD:", "bold", () -> false);
        prefs.preferenceDesc.push("HUD options for VS Sonic.EXE");

        createCheckboxIfMobileAllowed(prefs, "doGenesisHUD", "GENESIS HUD", "Toggles the GENESIS-styled HUD.", function(value:Bool) {
            Save.instance.modOptions.set("doGenesisHUD", value);
            doGenesisHUD = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doGenesisHUD"));

        createCheckboxIfMobileAllowed(prefs, "doColoredHealthBar", "Colored Health Bar", "Toggles icon based health bar colors.", function(value:Bool) {
            Save.instance.modOptions.set("doColoredHealthBar", value);
            doColoredHealthBar = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doColoredHealthBar"));

        createEnumIfMobileAllowed(prefs, "timerMode", "Timer Mode", "Switches the GENESIS HUD timer between counting up (default) or down", [
            "Count Up" => "Count Up",
            "Count Down" => "Count Down"
        ], function(key:String, value:String) {
            Save.instance.modOptions.set("timerMode", value);
            timerMode = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("timerMode"));

        // UI
        prefs.items.createItem(120, 120 * prefs.items.length + 30, "UI:", "bold", () -> false);
        prefs.preferenceDesc.push("UI options for VS Sonic.EXE");

        createCheckboxIfMobileAllowed(prefs, "doEXETitleIntro", "EXE Title Intro", "Toggles the intro video before the title screen.", function(value:Bool) {
            Save.instance.modOptions.set("doEXETitleIntro", value);
            doEXETitleIntro = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doEXETitleIntro"));

        createCheckboxIfMobileAllowed(prefs, "doEXETitleScreen", "EXE Title Screen", "Toggles the EXE-styled title screen.", function(value:Bool) {
            Save.instance.modOptions.set("doEXETitleScreen", value);
            doEXETitleScreen = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doEXETitleScreen"));

        createCheckboxIfMobileAllowed(prefs, "doEXEMenuScreen", "EXE Menu Screen", "Toggles the EXE-styled main menu screen.", function(value:Bool) {
            Save.instance.modOptions.set("doEXEMenuScreen", value);
            doEXEMenuScreen = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doEXEMenuScreen"));

        createEnumIfMobileAllowed(prefs, "freeplayBG", "Freeplay BG", "Switch between different freeplay backgrounds.", [
            "Default" => "Default",
            "Too Slow" => "Too Slow",
            "You Can't Run" => "You Can't Run",
            "Triple Trouble" => "Triple Trouble",
            "Endless" => "Endless",
            "Cycles" => "Cycles",
            "Faker" => "Faker",
            "Relax" => "Relax",
            "Prey" => "Prey",
            "Fatality" => "Fatality",
            "Personnel" => "Personnel",
            "Soulless" => "Soulless",
            "Fight or Flight" => "Fight or Flight"
        ], function(key:String, value:String) {
            Save.instance.modOptions.set("freeplayBG", value);
            freeplayBG = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("freeplayBG"));

        // EXTRAS
        prefs.items.createItem(120, 120 * prefs.items.length + 30, "MISC:", "bold", () -> false);
        prefs.preferenceDesc.push("Miscellaneous options for VS Sonic.EXE");

        createCheckboxIfMobileAllowed(prefs, "doSongTransitions", "Song Transitions", "Toggles song transitions in freeplay.", function(value:Bool) {
            Save.instance.modOptions.set("doSongTransitions", value);
            doSongTransitions = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doSongTransitions"));

        createCheckboxIfMobileAllowed(prefs, "doFreeplayCuts", "Freeplay Cutscenes", "Toggles cutscenes for certain songs in freeplay.", function(value:Bool) {
            Save.instance.modOptions.set("doFreeplayCuts", value);
            doFreeplayCuts = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doFreeplayCuts"));

        createCheckboxIfMobileAllowed(prefs, "doGenesisMode", "Genesis Mode", "Toggles extra visuals not typically seen in some songs.", function(value:Bool) {
            Save.instance.modOptions.set("doGenesisMode", value);
            doGenesisMode = value;
            Save.instance.flush();
        }, Save.instance.modOptions.get("doGenesisMode"));
    }
}