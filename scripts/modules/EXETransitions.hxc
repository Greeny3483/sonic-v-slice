import flixel.FlxG;
import flixel.util.FlxTimer;
import funkin.save.Save;
import funkin.util.TouchUtil;
import funkin.PlayerSettings;
import funkin.util.ReflectUtil;
import funkin.play.ResultState;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.ui.transition.LoadingState;
import funkin.ui.freeplay.FreeplayState;
import funkin.modding.module.Module;
import funkin.audio.FunkinSound;
import funkin.data.song.SongRegistry;

class EXETransitions extends Module {
    /* Because I wanted VS SONIC.EXE to be the only (exe related) week in story mode,
	    I felt this was a necessary addition. So that you can still experience the songs as if they were
		connected.

		And if it doesn't suit you, you can turn it off!
	*/

	var accepted:Bool = false;
	var enteredSong:Bool = false;

	var hasStoredVolume:Bool = false;
	var storedVolume:Float = 1;

	var switchToNextSong:String = "";
	var doSongTransitions:Bool = true;

	public function new() {
		super('EXETransitions');
	}

	override function onUpdate(event:UpdateScriptEvent) {
		super.onUpdate(event);

		doSongTransitions = Save.instance.modOptions["doSongTransitions"];
		if (!doSongTransitions) return;

		if (ReflectUtil.getClassNameOf(FlxG.state.subState) == "funkin.play.ResultState") {
			if (FlxG.state.subState.params.songId.toLowerCase() == 'faker') {
				switchToNextSong = 'black-sun';
			}
			
			if (FlxG.state.subState.params.songId.toLowerCase() == 'prey') {
				switchToNextSong = 'fight-or-flight';
			}

			if (PlayStatePlaylist.isStoryMode && PlayStatePlaylist.campaignId == '1round1' && FlxG.state.subState.params.songId.toLowerCase() == 'triple-trouble' && !FlxG.onMobile) {
				switchToNextSong = 'final-escape';
			}

			if (FlxG.state.subState.params.songId.toLowerCase() == 'relax') {
				switchToNextSong = 'round-a-bout';
			}

			if (FlxG.state.subState.params.songId.toLowerCase() == 'round-a-bout') {
				switchToNextSong = 'spike-trap';
			}		

			if ((PlayerSettings.player1.controls.PAUSE || (FlxG.onMobile && TouchUtil.justPressed))
				&& switchToNextSong != ""
				&& accepted != true) {
				enteredSong = false;

				FlxG.mouse.visible = false;

				if (FlxG.state.subState.introMusicAudio != null) {
					FlxG.state.subState.introMusicAudio.stop();
				}

				if (FlxG.sound.music != null) {
					FlxG.sound.music.stop();
				}

				FlxG.state.subState.cameraEverything.alpha = 0;
				FlxG.state.subState.cameraBG.alpha = 0;
				FlxG.state.subState.cameraScroll.alpha = 0;

				accepted = true;
			}

			if (accepted == true) {
				if (FlxG.sound.music != null) {
					FlxG.sound.music.volume = 0;
					FlxG.sound.music.stop();
				}
				if (FlxG.sound != null) {
					if (hasStoredVolume == false)
						storedVolume = FlxG.sound.volume;
					hasStoredVolume = true;
					FlxG.sound.volume = 0;
				}

				FlxG.mouse.visible = false;

				FlxG.switchState(new funkin.ui.freeplay.FreeplayState());
			}
		}

		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.freeplay.FreeplayState") {
			if (accepted == true) {
				if (FlxG.sound.music != null) {
					FlxG.sound.music.volume = 0;
					FlxG.sound.music.stop();
				}
				if (FlxG.sound != null) {
					// Ensure volume stays at 0 during transition
					FlxG.sound.volume = 0;
				}

				FlxG.mouse.visible = false;

				FlxG.state.funnyCam.alpha = 0;
				FlxG.state.rankCamera.alpha = 0;

				if (enteredSong == false) {
					PlayStatePlaylist.isStoryMode = false;

					var targetSongId:String = switchToNextSong;
					var targetSongNullable:Null<Song> = SongRegistry.instance.fetchEntry(targetSongId);
					var targetSong:Song = targetSongNullable;

					var targetDifficulty:Null<SongDifficulty> = targetSong.getDifficulty(FlxG.state.currentDifficulty);

					new FlxTimer().start(1, _ -> {
						hasStoredVolume = false;
						enteredSong = true;
						accepted = false;

						FlxG.state.changeSelection();
						switchToNextSong = "";

						FunkinSound.emptyPartialQueue();

						FlxG.sound.volume = storedVolume;

						LoadingState.loadPlayState({
							targetSong: targetSong,
							targetDifficulty: FlxG.state.currentDifficulty,
							targetVariation: null,
							targetInstrumental: null,
							practiceMode: false,
							minimalMode: false,
						}, true);
					});
				}
			}
		}
	}
}
