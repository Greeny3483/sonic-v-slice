import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.Paths;
import funkin.Conductor;
import funkin.save.Save;
import funkin.util.Constants;
import funkin.play.PlayState;
import funkin.play.Countdown;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;

class EXEIntros extends Module {
    public var songIntroCircle:FunkinSprite;
    public var songIntroText:FunkinSprite;
    public var encoreText:FunkinSprite;
    public var blackBackground:FlxSprite;
    public var songName:String;
    public var skipNextIntro:Bool = false;

    // These are the songs that will have a custom intro card
    // If listed here, the script will look for the assets in 'songIntros/songname/'
    public var supportedSongs = [
        'too-slow', 'you-cant-run', 'triple-trouble',
        'endless', 'cycles', 'execution', 'faker', 'black-sun', 
        'relax', 'round-a-bout', 'spike-trap', 'prey', 
        'fight-or-flight', 'slaybells'
    ];

    public function new() {
        super("EXEIntros");
    }

    function fetchIntroAssets():Void {
        songName = PlayState.instance.currentSong.id.toLowerCase();

        if (songIntroCircle != null) songIntroCircle.destroy();
        songIntroCircle = FunkinSprite.create(0, 0, "songIntros/" + songName + "/circle");
        songIntroCircle.cameras = [PlayState.instance.camCutscene];
        songIntroCircle.zIndex = 1000;
        songIntroCircle.visible = false;
        PlayState.instance.add(songIntroCircle);

        if (songIntroText != null) songIntroText.destroy();
        songIntroText = FunkinSprite.create(0, 0, "songIntros/" + songName + "/text");
        songIntroText.cameras = [PlayState.instance.camCutscene];
        songIntroText.zIndex = 1000;
        songIntroText.visible = false;
        PlayState.instance.add(songIntroText);

        if (PlayState.instance.currentVariation == "encore") {
            if (encoreText != null) encoreText.destroy();
            encoreText = FunkinSprite.create(0, 0, "songIntros/encore");
            encoreText.cameras = [PlayState.instance.camCutscene];
            encoreText.zIndex = 1000;
            encoreText.visible = false;
            PlayState.instance.add(encoreText);
        }

        if (blackBackground != null) blackBackground.destroy();
        blackBackground = new FlxSprite(0, 0);
        blackBackground.makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackBackground.cameras = [PlayState.instance.camCutscene];
        blackBackground.zIndex = 999;
        blackBackground.visible = false;
        PlayState.instance.add(blackBackground);
    }

    override function onCountdownStart(event:CountdownScriptEvent):Void {
        super.onCountdownStart(event);

        if (PlayState.instance == null || PlayState.instance.currentSong == null || event.cancelled) return;

        if (skipNextIntro) {
            skipNextIntro = false;
            return;
        }

        fetchIntroAssets();

        // Checks that the option is enabled and that it's one of the supported songs
        // If the song is Sunshine, force a lower BPM to slow down the countdown
        if (PlayState.instance.currentSong.id.toLowerCase() == "sunshine") {
            Conductor.instance.forceBPM(70);
        } else if (supportedSongs.indexOf(PlayState.instance.currentSong.id.toLowerCase()) != -1) {
            Constants.COUNTDOWN_VOLUME = 0;
            if (blackBackground != null) blackBackground.visible = true;
            startIntro();
        }
    }

    override function onCountdownEnd(event:CountdownScriptEvent):Void {
        super.onCountdownEnd(event);

        if (PlayState.instance == null || PlayState.instance.currentSong == null) return;

        if (PlayState.instance.currentSong.id.toLowerCase() == "sunshine") {
            Conductor.instance.forceBPM(105);
            return;
        }
    }

    public function startIntro():Void {
        // Circle comes from the left, text comes from the right, encore, if present, comes from the bottom

        if (songIntroCircle != null) {
            songIntroCircle.x = FlxG.width;
            songIntroCircle.alpha = 1;
            songIntroCircle.visible = true;

            FlxTween.tween(songIntroCircle, {x: (FlxG.width / 2) - (songIntroCircle.width / 2)}, 1.5, {
                ease: FlxEase.quadOut,
                onComplete: function(tween:FlxTween) {
                    FlxTween.tween(songIntroCircle, {alpha: 0}, 1, {
                        ease: FlxEase.quadOut,
                    });
                }
            });
        }

        if (songIntroText != null) {
            songIntroText.x = -songIntroText.width;
            songIntroText.alpha = 1;
            songIntroText.visible = true;

            FlxTween.tween(songIntroText, {x: (FlxG.width / 2) - (songIntroText.width / 2)}, 1.5, {
                ease: FlxEase.quadOut,
                onComplete: function(tween:FlxTween) {
                    FlxTween.tween(songIntroText, {alpha: 0}, 1, {
                        ease: FlxEase.quadOut,
                    });

                    if (blackBackground != null) {
                        FlxTween.tween(blackBackground, {alpha: 0}, 1, {
                            ease: FlxEase.quadOut,
                        });
                    }
                }
            });
        }

        if (encoreText != null && PlayState.instance.currentVariation == "encore") {
            encoreText.y = FlxG.height;
            encoreText.alpha = 1;
            encoreText.visible = true;

            FlxTween.tween(encoreText, {y: (FlxG.height / 2) - (encoreText.height / 2)}, 1.5, {
                ease: FlxEase.quadOut,
                onComplete: function(tween:FlxTween) {
                    FlxTween.tween(encoreText, {alpha: 0}, 1, {
                        ease: FlxEase.quadOut,
                    });
                }
            });
        }

        if (blackBackground != null) {
            blackBackground.visible = true;
            blackBackground.alpha = 1;
        }
    }
}