import flixel.FlxG;
import flixel.FlxSprite;
import funkin.Paths;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.play.notes.notekind.NoteKind;
import funkin.FunkinMemory;

import EXERingMechanic;

class RingNote extends NoteKind
{
    static final DISABLE_ANIMATIONS:Bool = true;

    public function new(noteKind:String, description:String = "", ?noteStyleId:String, ?params:Array<NoteKindParam>)
    {
        super("ringnote", "Ring Note (EXE)", "ringnote", [], DISABLE_ANIMATIONS);
        
        this.scoreable = false; 
    }

    function onNoteIncoming(event:Dynamic)
    {
        super.onNoteIncoming(event);
        event.note.lowPriority = true;
        FunkinMemory.permanentCacheSound(Paths.sound("Ring"));
    }

    function onNoteHit(event:Dynamic)
    {
        super.onNoteHit(event);
        FunkinSound.playOnce(Paths.sound("Ring"), 1);
    }

    function onNoteMiss(event:Dynamic)
    {
        event.cancelEvent();
    }
}